# Browser-safe Supabase values. Copy to .env for local development.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only values used by data scripts. Never prefix these with VITE_.
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@host:6543/postgres
